# Only publish plugin packages and their public development reference.
/*
!/.gitignore
!/README.md

!/plugins/
/plugins/*
!/plugins/glass-dome-emoji/
!/plugins/hello-desktop/
!/plugins/particle-dissolve/
!/plugins/plugin-template/

/plugins/glass-dome-emoji/*
!/plugins/glass-dome-emoji/plugin.json
!/plugins/glass-dome-emoji/main.js
!/plugins/glass-dome-emoji/glass.svg
!/plugins/glass-dome-emoji/README.md

/plugins/hello-desktop/*
!/plugins/hello-desktop/plugin.json
!/plugins/hello-desktop/main.js
!/plugins/hello-desktop/style.css

/plugins/particle-dissolve/*
!/plugins/particle-dissolve/plugin.json
!/plugins/particle-dissolve/main.js

/plugins/plugin-template/*
!/plugins/plugin-template/plugin.json
!/plugins/plugin-template/src/
/plugins/plugin-template/src/*
!/plugins/plugin-template/src/main.js
!/plugins/plugin-template/vendor/
/plugins/plugin-template/vendor/*
!/plugins/plugin-template/vendor/color-utils.mjs

!/docs/
/docs/*
!/docs/PLUGIN_SPEC.md
!/docs/PLUGIN_API.md
!/docs/VISUAL_PLUGIN_SDK.md
!/docs/COMPLIANCE.md

!/sdk/
/sdk/*
!/sdk/plugin.schema.json
!/sdk/sdk.d.ts

# Local previews, tests, builds and editor files stay in the workspace.
/demos/
/tests/
/build/
/dist/
/.local/
/.vscode/
/node_modules/
